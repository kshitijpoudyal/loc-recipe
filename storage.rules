rules_version = '2';

// Proposed Storage rules. Review against the deployed rules before running
// `firebase deploy --only storage`.
service firebase.storage {
  match /b/{bucket}/o {

    // New uploads: recipe/{uid}/{file}, written only by that user,
    // images only, 10MB max.
    match /recipe/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Images uploaded before per-user folders existed: keep them readable,
    // but nobody can overwrite them any more.
    match /recipe/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
